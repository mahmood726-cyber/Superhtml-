            // REPORT GENERATOR
            generateReport(){
                if(!this.currRes)return;
                const r=this.currRes, c=this.cfg, k=r.studies.length;
                const metMap = {'RR':'Risk Ratio','OR':'Odds Ratio','RD':'Risk Difference','MD':'Mean Difference','SMD':'Standardized Mean Difference','HR':'Hazard Ratio','Prop':'Proportion'};
                
                let mText = `A systematic meta-analysis was conducted using 786-MIII software. We applied the ${c.model} effects model using the ${c.pool==='mh'?'Mantel-Haenszel':'Inverse Variance'} method. Between-study variance (tau-squared) was estimated via the ${c.est.toUpperCase()} estimator. ${c.hk?'To adjust for uncertainty, the Hartung-Knapp-Sidik-Jonkman (HKSJ) method was used for confidence intervals. ':''}Heterogeneity was quantified using the I² statistic and Cochran's Q test. Publication bias was assessed via funnel plots and Egger's test (alpha=0.1). Statistical significance was defined as p<0.05.`;
                document.getElementById('txt-methods').value = mText;
                this.checkWC('wc-methods', mText, 70, 90);

                let rText = `A total of ${k} studies were included in the final quantitative synthesis. The pooled ${metMap[c.metric]||c.metric} was ${r.displayVal.toFixed(2)} (95% CI: ${r.lo.toFixed(2)} to ${r.hi.toFixed(2)}). `;
                rText += r.pVal<0.05 ? `This result was statistically significant (p=${r.pVal.toFixed(3)}), indicating a meaningful effect. ` : `This result was not statistically significant (p=${r.pVal.toFixed(3)}), suggesting insufficient evidence of an effect. `;
                rText += `\n\nHeterogeneity analysis revealed an I² of ${r.I2.toFixed(0)}% (Q=${r.Q.toFixed(2)}, p=${Engine.getP(Math.sqrt(r.Q)).toFixed(2)}), indicating ${r.I2>50?'substantial':'low/moderate'} variability. Tau-squared was estimated at ${r.tau2.toFixed(3)}. `;
                if(r.pi_lo!==null){
                    const nullV = Metric.isLogRatio(c.metric)?1:0;
                    const cross = (r.pi_lo < nullV && r.pi_hi > nullV);
                    rText += `The 95% prediction interval ranged from ${r.pi_lo.toFixed(2)} to ${r.pi_hi.toFixed(2)}. This interval ${cross?'crosses':'excludes'} the null value, suggesting that the effect ${cross?'may vary in direction':'is consistent'} across future settings. `;
                }
                const egg=Engine.eggersTest(r.studies);
                if(egg.p!==null) rText += `\n\nSmall-study effects were assessed using Egger's regression test (Intercept=${egg.intercept.toFixed(2)}, p=${egg.p.toFixed(3)}), ${egg.p<0.1?'indicating potential publication bias':'suggesting no significant asymmetry'}. Sensitivity analyses, including Leave-One-Out, were performed to verify robustness. Overall, while the aggregated estimate provides a summary of current evidence, heterogeneity warrants cautious interpretation regarding generalizability.`;
                else rText += `\n\nPublication bias tests were not performed due to the low number of studies (k<3). The stability of the results was confirmed through sensitivity analyses. Overall, while the aggregated estimate provides a summary, the small sample size warrants cautious interpretation.`;
                
                if(rText.split(' ').length < 180) rText += " Further high-quality randomized controlled trials with consistent methodologies are recommended to reduce uncertainty and provide more definitive conclusions regarding efficacy.";

