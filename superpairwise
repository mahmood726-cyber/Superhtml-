            plotSubgroup(st){ const g=[...new Set(st.map(e=>e.group||'All'))]; let t=[], y=0; g.forEach(grp=>{const s=st.filter(e=>(e.group||'All')===grp),r=Engine.pool(s,this.cfg.model,this.cfg.pool,this.cfg.est,this.cfg.hk);if(r){t.push({x:s.map(e=>e.displayVal),y:s.map((_,i)=>y+i),mode:'markers',name:grp,marker:{color:'#94a3b8'}}); y+=s.length; t.push({x:[r.displayVal],y:[y],mode:'markers',marker:{symbol:'diamond',color:'#000',size:10},name:grp+' Pooled'}); y+=2;}}); Plotly.newPlot('plot-subgroup',t,{xaxis:{type:Metric.isLogRatio(this.cfg.metric)?'log':'linear'},margin:{l:100},yaxis:{showticklabels:false}},{displayModeBar:false}); },
